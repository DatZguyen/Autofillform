{
  "manifest_version": 3,
  "name": "Google Forms AI Auto-Fill & Submitter",
  "version": "1.0.0",
  "description": "Tu dong boc tach Google Forms, phan bo ty le %, sinh cau tra loi bang Gemini AI va submit hang loat da nhiem (toi da 10 tab an).",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Forms AI Auto-Fill"
  },
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://www.google.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ]
}
