{
  "manifest_version": 3,
  "name": "Google Forms Auto-Fill & Submitter",
  "version": "1.2.0",
  "description": "Tu dong boc tach Google Forms (multi-page, ranh nhanh), phan bo ty le dap an, chon random noi dung nhap lieu va submit hang loat da nhiem (toi da 10 tab an).",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Forms Auto-Fill",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
